<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180" width="180" height="180">
  <!-- Background circle with gradient -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#14b8a6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#10b981;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="calcGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:0.95" />
      <stop offset="100%" style="stop-color:#f8fafc;stop-opacity:0.9" />
    </linearGradient>
  </defs>
  
  <circle cx="90" cy="90" r="90" fill="url(#bgGradient)"/>
  
  <!-- Calculator shadow -->
  <ellipse cx="95" cy="95" rx="75" ry="75" fill="#000000" opacity="0.1" blur="2"/>
  
  <!-- Main calculator body -->
  <rect x="35" y="45" width="110" height="100" rx="8" fill="url(#calcGradient)" stroke="#ffffff" stroke-width="2"/>
  
  <!-- Display screen -->
  <rect x="45" y="55" width="90" height="35" rx="4" fill="#1e293b"/>
  <rect x="48" y="58" width="84" height="29" rx="2" fill="#334155"/>
  
  <!-- Display text (Tip Calculator) -->
  <text x="90" y="75" font-family="Arial, sans-serif" font-size="8" font-weight="bold" fill="#ffffff" text-anchor="middle">TIP</text>
  <text x="90" y="83" font-family="Arial, sans-serif" font-size="6" fill="#94a3b8" text-anchor="middle">CALC</text>
  
  <!-- Calculator buttons with grid -->
  <!-- Row 1 -->
  <g>
    <rect x="45" y="105" width="16" height="16" rx="2" fill="#14b8a6" opacity="0.8"/>
    <rect x="66" y="105" width="16" height="16" rx="2" fill="#14b8a6" opacity="0.8"/>
    <rect x="87" y="105" width="16" height="16" rx="2" fill="#14b8a6" opacity="0.8"/>
    <rect x="108" y="105" width="16" height="16" rx="2" fill="#14b8a6" opacity="0.8"/>
  </g>
  
  <!-- Row 2 -->
  <g>
    <rect x="45" y="125" width="16" height="16" rx="2" fill="#14b8a6" opacity="0.8"/>
    <rect x="66" y="125" width="16" height="16" rx="2" fill="#14b8a6" opacity="0.8"/>
    <rect x="87" y="125" width="16" height="16" rx="2" fill="#14b8a6" opacity="0.8"/>
    <rect x="108" y="125" width="16" height="16" rx="2" fill="#14b8a6" opacity="0.8"/>
  </g>
  
  <!-- Percentage symbols -->
  <text x="53" y="116" font-family="Arial, sans-serif" font-size="10" font-weight="bold" fill="#ffffff" text-anchor="middle">10%</text>
  <text x="74" y="116" font-family="Arial, sans-serif" font-size="10" font-weight="bold" fill="#ffffff" text-anchor="middle">20%</text>
  <text x="95" y="116" font-family="Arial, sans-serif" font-size="10" font-weight="bold" fill="#ffffff" text-anchor="middle">50%</text>
  
  <!-- Tip icon -->
  <g transform="translate(108, 116)">
    <path d="M 0 0 L 3 -3 L 6 0 L 3 3 Z" fill="#22c55e"/>
    <circle cx="3" cy="3" r="2" fill="#22c55e"/>
  </g>
</svg>